FROM --platform=linux/amd64 mirror.gcr.io/library/python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
# Standard library only, like the API image.
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY awslite.py common.py snapshotter.py ./
USER 10001:10001
ENTRYPOINT ["python3", "/app/snapshotter.py"]
